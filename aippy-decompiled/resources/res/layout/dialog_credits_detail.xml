<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/dialog_credits_detail_0"
    android:background="@drawable/bg_credits_detail_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/grab_indicator"
        android:background="@drawable/bg_credits_grab_indicator"
        android:layout_width="60dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"/>
    <FrameLayout
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_credits_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_diamond_credits"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@+id/tv_credits_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="4dp"
                android:letterSpacing="0.04"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffb3b3b3"
                android:layout_gravity="bottom"
                android:id="@+id/tv_credits_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="@string/credits_unit"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_credits_close"
            android:scaleType="centerInside"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:id="@+id/tv_monthly_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff898989"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/monthly_credits"
            android:layout_marginStart="4dp"/>
        <View
            android:background="#ff4d4d4d"
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginHorizontal="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:id="@+id/tv_addon_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ff898989"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/addon_credits"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <View
        android:background="#ff333333"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:background="#ff1c1c1c"
            android:paddingBottom="98dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/bottom_gradient"
            android:background="@drawable/bg_credits_bottom_gradient"
            android:layout_width="match_parent"
            android:layout_height="98dp"/>
    </FrameLayout>
</LinearLayout>

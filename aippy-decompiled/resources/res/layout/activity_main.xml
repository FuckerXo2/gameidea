<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root_layout"
    android:tag="layout/activity_main_0"
    android:background="#0d0d0d"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/bottom_nav_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/bottom_tab_container"
            android:background="@drawable/img_bg_bottom_tab"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/tab_home"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/icon_home"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_tab_game"
                    android:tint="@android:color/white"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/tab_explore"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/icon_explore"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_tab_explore"
                    android:tint="@android:color/white"
                    android:contentDescription="@string/explore_tab_description"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/tab_activity"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/icon_activity"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_tab_bell"
                        android:tint="@android:color/white"/>
                    <View
                        android:layout_gravity="end|top"
                        android:id="@+id/view_unread_dot"
                        android:background="@drawable/bg_circle_red"
                        android:visibility="gone"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="20dp"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/tab_mine"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/icon_mine"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_tab_profile"
                    android:tint="@android:color/white"/>
            </LinearLayout>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_add"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_main_add"
            android:contentDescription="@string/add_button_description"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

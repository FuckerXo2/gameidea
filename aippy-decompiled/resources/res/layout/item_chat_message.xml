<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="4dp"
    android:paddingTop="8dp"
    android:paddingRight="4dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="4dp"
    android:paddingVertical="8dp">
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:id="@+id/layout_user"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_width="60dp"
            android:layout_height="0dp"/>
        <LinearLayout
            android:gravity="end"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_user_bubble"
                android:background="@drawable/bg_chat_bubble_user"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_user_media"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_gravity="end"
                    android:orientation="vertical"
                    android:id="@+id/layout_user_audio"
                    android:visibility="gone"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:gravity="end"
                    android:orientation="vertical"
                    android:id="@+id/layout_user_text_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_content_user"
                        android:paddingLeft="8dp"
                        android:paddingTop="4dp"
                        android:paddingRight="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="260dp"
                        android:paddingHorizontal="8dp"/>
                    <View
                        android:id="@+id/view_gradient_mask"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_8E8E93"
                android:gravity="center"
                android:id="@+id/tv_expand_toggle"
                android:background="@drawable/bg_thinking_toggle"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"
                android:text="@string/show_more"
                android:paddingHorizontal="12dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/img_avatar_user"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_aippy_avatar"
            android:contentDescription="@null"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:id="@+id/layout_assistant"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="start"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">
            <ImageView
                android:id="@+id/img_avatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_aippy_avatar"
                android:contentDescription="@null"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/layout_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_ai_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name_s"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/color_8E8E93"
                        android:gravity="center"
                        android:id="@+id/tv_thinking_toggle"
                        android:background="@drawable/bg_thinking_toggle"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:text="@string/thinking"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="12dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>

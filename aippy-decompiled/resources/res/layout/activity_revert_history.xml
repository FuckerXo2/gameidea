<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_revert_history_0"
    android:background="#0d0d0d"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="#0d0d0d"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/status_bar_view"
            android:background="#0d0d0d"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/nav_bar"
            android:background="#0d0d0d"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <ImageButton
                android:id="@+id/btn_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_revert_nav_close"
                android:scaleType="centerInside"
                android:contentDescription="@string/back"
                android:layout_marginStart="10dp"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/btn_prev"
                android:background="@drawable/bg_revert_nav_circle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_revert_nav_prev"
                android:scaleType="centerInside"
                android:layout_marginEnd="4dp"/>
            <ImageButton
                android:id="@+id/btn_next"
                android:background="@drawable/bg_revert_nav_circle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_revert_nav_next"
                android:scaleType="centerInside"
                android:layout_marginStart="4dp"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageButton
                android:id="@+id/btn_refresh"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_revert_nav_refresh"
                android:scaleType="centerInside"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:background="#0d0d0d"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <RelativeLayout
            android:id="@+id/info_bar"
            android:background="#0d0d0d"
            android:layout_width="match_parent"
            android:layout_height="154dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <FrameLayout
                android:id="@+id/revert_container"
                android:layout_width="200dp"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:layout_alignParentEnd="true">
                <Button
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:id="@+id/btn_revert"
                    android:background="@drawable/bg_revert_button_green"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/revert"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"/>
                <com.airbnb.lottie.LottieAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/revert_loading_lottie"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:lottie_autoPlay="false"
                    app:lottie_fileName="login_loading_lottie.json"
                    app:lottie_loop="true"/>
                <View
                    android:id="@+id/revert_overlay"
                    android:background="@drawable/bg_revert_overlay"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tv_version_tag"
                android:background="@drawable/bg_version_tag"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="14dp"
                android:minWidth="44dp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#b3b3b3"
                android:ellipsize="end"
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:layout_below="@+id/tv_version_tag"
                android:layout_marginEnd="10dp"
                android:layout_toStartOf="@+id/revert_container"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:id="@+id/tv_commit_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:maxLines="2"
                android:layout_below="@+id/tv_time"/>
        </RelativeLayout>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="#999999"
        android:layout_gravity="center"
        android:id="@+id/empty_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_version_yet"/>
</FrameLayout>

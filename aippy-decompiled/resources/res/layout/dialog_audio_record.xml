<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_photo_picker_panel"
    android:paddingBottom="40dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:outlineProvider="background"
    android:clipToOutline="true">
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_grabber"
        android:layout_width="52dp"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_initial"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/btn_import_video"
                android:background="@drawable/bg_import_card"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/sound_import_from_video"
                    android:tint="#b3b3b3"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/import_from_video"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/btn_import_files"
                android:background="@drawable/bg_import_card"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/sound_import_from_file"
                    android:tint="#b3b3b3"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/import_from_files"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="#b3b3b3"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/or_record_audio"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_record"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/sound_record_start_icon"
            android:contentDescription="@null"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/layout_recording"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp">
        <FrameLayout
            android:id="@+id/layout_waveform"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="20dp"/>
        <TextView
            android:textSize="28sp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/timer_default"
            android:fontFamily="sans-serif-light"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_stop"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/sound_record_stop_icon"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#8e8e93"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_max_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/up_to_60_seconds"/>
    </LinearLayout>
</LinearLayout>

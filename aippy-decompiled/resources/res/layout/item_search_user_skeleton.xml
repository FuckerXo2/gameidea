<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_base_color="#1affffff"
    app:shimmer_direction="left_to_right"
    app:shimmer_duration="1000"
    app:shimmer_highlight_color="#33ffffff"
    app:shimmer_repeat_count="-1">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <View
            android:id="@+id/skeleton_avatar"
            android:background="@drawable/skeleton_background_circle"
            android:layout_width="54dp"
            android:layout_height="54dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/skeleton_nickname"
            android:background="@drawable/skeleton_background"
            android:layout_width="120dp"
            android:layout_height="14dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/skeleton_avatar"
            app:layout_constraintTop_toTopOf="@+id/skeleton_avatar"/>
        <View
            android:id="@+id/skeleton_username"
            android:background="@drawable/skeleton_background"
            android:layout_width="90dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/skeleton_avatar"
            app:layout_constraintTop_toBottomOf="@+id/skeleton_nickname"/>
        <View
            android:id="@+id/skeleton_followers"
            android:background="@drawable/skeleton_background"
            android:layout_width="140dp"
            android:layout_height="11dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@+id/skeleton_avatar"
            app:layout_constraintTop_toBottomOf="@+id/skeleton_username"/>
        <View
            android:id="@+id/skeleton_follow_btn"
            android:background="@drawable/skeleton_background"
            android:layout_width="86dp"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="#252525"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/skeleton_avatar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>

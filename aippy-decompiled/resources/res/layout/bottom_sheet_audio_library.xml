<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/container"
        android:background="@drawable/bg_photo_picker_panel"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:outlineProvider="background"
        android:clipToOutline="true">
        <FrameLayout
            android:id="@+id/grabber_area"
            android:layout_width="match_parent"
            android:layout_height="28dp">
            <View
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_grabber"
                android:layout_width="52dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/layout_category_header"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <HorizontalScrollView
                android:id="@+id/scroll_categories"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="48dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/layout_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </HorizontalScrollView>
            <View
                android:layout_gravity="bottom"
                android:background="#2c2c2c"
                android:layout_width="1dp"
                android:layout_height="1dp"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/btn_search"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/chat_sound_search_icon"
                android:contentDescription="@null"
                android:layout_marginEnd="10dp"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_search_header"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="10dp">
            <ImageView
                android:id="@+id/btn_back"
                android:padding="6dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/chat_sound_import_back_icon"
                android:contentDescription="@null"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_search_input"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:paddingHorizontal="12dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/chat_sound_search_icon"
                    android:contentDescription="@null"
                    android:alpha="0.5"/>
                <EditText
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:textColorHint="#8e8e93"
                    android:id="@+id/et_search"
                    android:background="@android:color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/search_audio_hint"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:layout_marginStart="8dp"/>
                <ImageView
                    android:id="@+id/btn_clear"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close_button"
                    android:contentDescription="@null"
                    android:alpha="0.5"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="#00e676"
                android:id="@+id/btn_search_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_audio"
                android:paddingTop="10dp"
                android:paddingBottom="80dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_search"
                android:paddingTop="10dp"
                android:paddingBottom="80dp"
                android:visibility="gone"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/layout_empty"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_create_sounds"
                    android:contentDescription="@null"
                    android:alpha="0.4"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#8e8e93"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/no_result"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/layout_search_init"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_create_sounds"
                    android:contentDescription="@null"
                    android:alpha="0.3"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/btn_import_audio"
                android:background="@drawable/bg_import_audio_button"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingHorizontal="20dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/chat_sound_import_icon"
                    android:contentDescription="@null"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/import_audio"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>

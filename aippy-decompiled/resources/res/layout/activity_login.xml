<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:tag="layout/activity_login_0"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_mascot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/img_mascot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="192:170"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.24"
        app:layout_constraintWidth_percent="0.5"/>
    <FrameLayout
        android:id="@+id/btn_google_login_container"
        android:background="@drawable/btn_google_login_bg"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_facebook_login_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/img_google_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_google_logo"
            android:contentDescription="@string/continue_with_google"
            android:layout_marginStart="80dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="#0d0d0d"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_google_login_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/continue_with_google"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="112dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/btn_facebook_login_container"
        android:background="@drawable/btn_facebook_login_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_email_login_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/img_facebook_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_facebook_logo"
            android:contentDescription="@string/continue_with_facebook"
            android:layout_marginStart="80dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="#0d0d0d"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_facebook_login_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/continue_with_facebook"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="112dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/btn_email_login_container"
        android:background="@drawable/btn_email_login_bg"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_legal_disclaimer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:layout_gravity="center"
            android:id="@+id/tv_email_login_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/continue_with_email"
            android:fontFamily="sans-serif-medium"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#99ffffff"
        android:gravity="center"
        android:autoLink="web"
        android:linksClickable="true"
        android:id="@+id/tv_legal_disclaimer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="82dp"
        android:layout_marginEnd="82dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

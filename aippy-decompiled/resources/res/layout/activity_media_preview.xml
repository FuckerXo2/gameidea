<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/base_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.module.common.photocrop.internal.ui.widget.PreviewViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:elevation="4dp">
        <com.module.common.ui.widget.blur.RealtimeBlurView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:realtimeBlurRadius="20dp"
            app:realtimeDownsampleFactor="8"
            app:realtimeOverlayColor="#b3ffffff"/>
        <com.module.common.smarttablayout.SmartTabLayout
            android:id="@+id/tab_layout"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:stl_distributeEvenly="false"
            app:stl_dividerThickness="0dp"
            app:stl_indicatorColor="@android:color/transparent"
            app:stl_indicatorCornerRadius="0dp"
            app:stl_indicatorInterpolation="smart"
            app:stl_indicatorThickness="0dp"
            app:stl_indicatorWidth="0dp"
            app:stl_titleOffset="auto_center"
            app:stl_underlineColor="@android:color/transparent"/>
        <View
            android:id="@+id/v_line"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/tab_layout"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="#00e676"
            android:id="@+id/button_apply"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.Toolbar
        android:theme="?attr/toolbar"
        android:id="@+id/toolbar"
        android:background="?attr/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/icon_black_back">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="18sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_index"
                android:layout_width="wrap_content"
                android:layout_height="?attr/actionBarSize"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="top|right"
            android:id="@+id/check_view"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="8dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/img_selected"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/im_photos_selector_grey"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_count"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </androidx.appcompat.widget.Toolbar>
</RelativeLayout>

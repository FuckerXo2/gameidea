        <shape>
            <solid android:color="#3a3a3c"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <solid android:color="#00d26a"/>
                <corners android:radius="2dp"/>
            </shape>
        </clip>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/element_radius_default" />
            <solid android:color="?appThemeColorDisabledButtonBackground" />
        </shape>
    </item>
    <item>
        <ripple android:color="@color/plato_transparent_black_4C">
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/element_radius_default" />
                    <solid android:color="?appThemeColorScreenBackgroundPrimary" />
                    <stroke android:width="1.0dp" android:color="?appThemeColorDividerLine" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>

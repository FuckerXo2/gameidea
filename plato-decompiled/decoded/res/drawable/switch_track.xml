<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/element_radius_large" />
            <solid android:color="?appThemeColorSwitchTrackActiveDisabled" />
        </shape>
    </item>
    <item android:state_enabled="false" android:state_checked="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/element_radius_large" />
            <solid android:color="?appThemeColorSwitchTrackInactiveDisabled" />
            <stroke android:width="@dimen/switch_border_width" android:color="?appThemeColorSwitchTrackBorderInactive" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/element_radius_large" />
            <solid android:color="?appThemeColorSwitchTrackActive" />
        </shape>
    </item>
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/element_radius_large" />
            <solid android:color="?appThemeColorSwitchTrackInactive" />
            <stroke android:width="@dimen/switch_border_width" android:color="?appThemeColorSwitchTrackBorderActive" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_enabled="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/element_radius_default" />
            <stroke android:width="2.0dp" android:color="@color/plato_darker_blue" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/element_radius_default" />
            <stroke android:width="2.0dp" android:color="@color/plato_off" />
        </shape>
    </item>
</selector>

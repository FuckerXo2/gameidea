<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <ripple android:color="@color/plato_list_selector">
            <item android:id="@android:id/mask" android:left="@dimen/item_bottom_navigation_bar_horizontal_margin" android:top="@dimen/item_bottom_navigation_bar_vertical_margin" android:right="@dimen/item_bottom_navigation_bar_horizontal_margin" android:bottom="@dimen/item_bottom_navigation_bar_vertical_margin">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/white" />
                    <corners android:radius="@dimen/home_navigation_button_corner_radius" />
                </shape>
            </item>
        </ripple>
    </item>
    <item android:left="@dimen/item_bottom_navigation_bar_horizontal_margin" android:top="@dimen/item_bottom_navigation_bar_vertical_margin" android:right="@dimen/item_bottom_navigation_bar_horizontal_margin" android:bottom="@dimen/item_bottom_navigation_bar_vertical_margin">
        <shape android:shape="rectangle">
            <solid android:color="@color/plato_light_blue" />
            <corners android:radius="@dimen/home_navigation_button_corner_radius" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="false" android:color="?appThemeColorSwitchThumbInactiveDisabled" />
    <item android:state_checked="false" android:state_pressed="true" android:color="?appThemeColorSwitchThumbInactivePressed" />
    <item android:state_pressed="true" android:color="?appThemeColorSwitchThumbActivePressed" />
    <item android:state_checked="true" android:color="?appThemeColorSwitchThumbActive" />
    <item android:state_checked="false" android:color="?appThemeColorSwitchThumbInactive" />
</selector>
